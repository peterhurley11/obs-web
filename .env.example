# Copy this file to .env and fill in the real values. .env is gitignored.

# "Publish to web" CSV export URL for the Hold The Phone roster sheet.
# In Google Sheets: File -> Share -> Publish to web -> select the sheet -> CSV.
SHEET_CSV_URL=

# How often (ms) to re-poll the sheet. Google's published-CSV endpoint is
# itself cached for a few minutes, so polling much faster has little benefit.
SHEET_POLL_MS=20000
